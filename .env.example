# ============================================================
# 環境変数テンプレート — OCR口座振替依頼書処理システム
# ============================================================
# 使い方:
#   1. このファイルを .env にコピー: cp .env.example .env
#   2. 各値を実際の環境に合わせて設定
#   3. .env ファイルはGitにコミットしないこと
# ============================================================

# === AWS認証情報 ===
# EC2にIAMロールを付与する場合は不要（推奨）
# IAMロールを使わない場合のみ設定
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=  # 一時認証の場合のみ

# === AWS基本設定 ===
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1

# === Amazon Bedrock設定 ===
# OCRエンジン: Claude Sonnet 4（東京リージョンInference Profile）
BEDROCK_INFERENCE_PROFILE_ID=jp.anthropic.claude-sonnet-4-6

# === S3ストレージ設定 ===
S3_BUCKET_NAME=cheiru-ocr-storage
S3_INPUT_PREFIX=00_input
S3_OUTPUT_PREFIX=01_output
S3_ARCHIVE_PREFIX=02_archive

# === OCR設定 ===
# 信頼度閾値（%）: この値以下はレビュー対象
CONFIDENCE_THRESHOLD=70.0
# Claudeの最大出力トークン数
CLAUDE_MAX_TOKENS=1024
# PDF→画像変換DPI
PDF_RENDER_DPI=300
# ファイルサイズ上限（バイト）: 50MB
MAX_FILE_SIZE_BYTES=52428800

# === リトライ設定 ===
BEDROCK_MAX_RETRIES=3
BEDROCK_RETRY_MIN_WAIT=2
BEDROCK_RETRY_MAX_WAIT=15

# === アプリケーション設定 ===
# 本番ドメイン（CORS設定に使用）
# 例: https://ocr.example.com
ALLOWED_ORIGINS=https://your-domain.com

# === ログ設定 ===
LOG_LEVEL=INFO
