# ============================================================
# 環境変数テンプレート — OCR口座振替依頼書処理システム
# ============================================================
# 使い方:
#   1. このファイルを .env にコピー: cp .env.example .env
#   2. 各値を実際の環境に合わせて設定
#   3. .env ファイルはGitにコミットしないこと
# ============================================================

# === AWS認証情報 ===
# EC2にIAMロールを付与する場合は不要（推奨）
# IAMロールを使わない場合のみ設定
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=  # 一時認証の場合のみ

# === AWS基本設定 ===
AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1

# === Amazon Bedrock設定 ===
# OCRエンジン: Claude Sonnet 4（東京リージョンInference Profile）
BEDROCK_INFERENCE_PROFILE_ID=jp.anthropic.claude-sonnet-4-6

# === S3ストレージ設定 ===
S3_BUCKET_NAME=cheiru-ocr-storage
S3_INPUT_PREFIX=00_input
S3_OUTPUT_PREFIX=01_output
S3_ARCHIVE_PREFIX=02_archive

# === OCR設定 ===
# 信頼度閾値（%）: この値以下はレビュー対象
CONFIDENCE_THRESHOLD=70.0
# Claudeの最大出力トークン数
CLAUDE_MAX_TOKENS=1024
# PDF→画像変換DPI
PDF_RENDER_DPI=300
# ファイルサイズ上限（バイト）: 50MB
MAX_FILE_SIZE_BYTES=52428800

# === リトライ設定 ===
BEDROCK_MAX_RETRIES=3
BEDROCK_RETRY_MIN_WAIT=2
BEDROCK_RETRY_MAX_WAIT=15

#? === アプリケーション設定 ===
# 本番ドメイン（CORS設定に使用）。カンマ区切りで複数指定可。
# 例: https://ocr.example.com
ALLOWED_ORIGINS=https://ai-ocr.ksai-dev.com

# === ログ設定 ===
LOG_LEVEL=INFO

# ============================================================
# 認証設定（AWS Cognito）
# ============================================================
# 認証の有効/無効。本番では必ず true。ローカル開発で認証をバイパスしたい場合のみ false。
AUTH_ENABLED=true

#? Cognito User Pool ID（例: ap-northeast-1_xxxxxxxxx） =>  N8mRA3MRS
COGNITO_USER_POOL_ID=ap-northeast-1_N8mRA3MRS

#? App Client ID
COGNITO_CLIENT_ID=6l7gofnc3muro8gbdlhei90e68

#? App Client Secret（App Clientで「クライアントシークレットを生成」した場合のみ設定）
COGNITO_CLIENT_SECRET=tol6s8pr8fkm9fskko6rf8kogll9g9ifpmh8ihb0f88oitcfvti

# Cognitoのリージョン（未指定時は AWS_REGION を流用）
COGNITO_REGION=ap-northeast-1

#? Hosted UI ドメイン（プロトコル込み。末尾スラッシュなし）
# 例: https://ocr-auth.auth.ap-northeast-1.amazoncognito.com   // https://ap-northeast-1n8mra3mrs.auth.ap-northeast-1.amazoncognito.com
COGNITO_DOMAIN=https://ap-northeast-1n8mra3mrs.auth.ap-northeast-1.amazoncognito.com

#? OAuthコールバックURL（本番の実ドメインに合わせる）
# 例: https://ocr.example.com/api/auth/callback
COGNITO_REDIRECT_URI=https://ai-ocr.ksai-dev.com/api/auth/callback

#? ログアウト後のリダイレクト先
COGNITO_LOGOUT_REDIRECT_URI=https://ai-ocr.ksai-dev.com/

# 権限グループ名（Cognito Group）
COGNITO_GROUP_ADMIN=ocr-admin
COGNITO_GROUP_USER=ocr-user

# ============================================================
# 監査ログ設定
# ============================================================
# 監査ログ出力先ディレクトリ（コンテナ内パス。app-logsボリューム配下を推奨）
AUDIT_LOG_DIR=/app/logs/audit
# 監査ログのバックエンド（現状は json のみ。将来 s3 / cloudwatch / dynamodb 等に拡張予定）
AUDIT_LOG_BACKEND=json
